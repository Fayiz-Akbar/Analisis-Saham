// Prisma Schema for AI-Powered Fundamental Investment Analyzer
// Primary Database: PostgreSQL 17

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum InvestorProfile {
  BEGINNER
  EXPERIENCED
}

enum SentimentLabel {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum MacroCategory {
  GLOBAL_INDEX
  COMMODITY
}

enum TransactionType {
  BUY
  SELL
}

// Peran pengguna untuk Role-Based Access Control (KF-01, KNF-01)
enum UserRole {
  INVESTOR
  ADMIN
}

// Tingkat pembelajaran kurikulum 3 level (Pemula, Menengah, Mahir)
enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Kunci jawaban resmi kuis pilihan ganda (deterministik A-D)
enum QuizOptionKey {
  A
  B
  C
  D
}

// ==========================================
// SUB-SISTEM 1: FAYIZ (STOCK ANALYSIS & AI)
// ==========================================

model User {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(100)
  email           String          @unique @db.VarChar(150)
  passwordHash    String          @map("password_hash") @db.VarChar(255)
  role            UserRole        @default(INVESTOR)
  investorProfile InvestorProfile @default(BEGINNER) @map("investor_profile")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  watchlists            Watchlist[]
  aiAnalysisLogs        AiAnalysisLog[]
  portfolioTransactions PortfolioTransaction[]
  learningProgresses    LearningProgress[]
  quizAttempts          QuizAttempt[]

  @@index([role])
  @@map("users")
}

model Stock {
  symbol      String   @id @db.VarChar(10) // Contoh: BBCA, BBRI, TLKM
  companyName String   @map("company_name") @db.VarChar(255)
  sector      String   @db.VarChar(100)
  industry    String   @db.VarChar(100)
  logoUrl     String?  @map("logo_url") @db.VarChar(500)
  exchange    String   @default("IDX") @db.VarChar(20)
  isIdx80     Boolean  @default(true) @map("is_idx80")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  fundamentals          StockFundamental?
  dailyPrice            StockDailyPrice?
  news                  NewsSentiment[]
  watchlists            Watchlist[]
  aiAnalysisLogs        AiAnalysisLog[]
  portfolioTransactions PortfolioTransaction[]

  @@index([sector])
  @@index([isIdx80])
  @@map("stocks")
}

model StockFundamental {
  id               String   @id @default(uuid()) @db.Uuid
  symbol           String   @unique @db.VarChar(10)
  marketCap        Decimal? @map("market_cap") @db.Decimal(20, 2)
  peRatio          Decimal? @map("pe_ratio") @db.Decimal(10, 2)
  pbvRatio         Decimal? @map("pbv_ratio") @db.Decimal(10, 2)
  roe              Decimal? @db.Decimal(8, 4)
  roa              Decimal? @db.Decimal(8, 4)
  der              Decimal? @db.Decimal(8, 4)
  netProfitMargin  Decimal? @map("net_profit_margin") @db.Decimal(8, 4)
  eps              Decimal? @db.Decimal(15, 2)
  dividendYield    Decimal? @map("dividend_yield") @db.Decimal(8, 4)
  revenue          Decimal? @db.Decimal(20, 2)
  netIncome        Decimal? @map("net_income") @db.Decimal(20, 2)
  totalAssets      Decimal? @map("total_assets") @db.Decimal(20, 2)
  totalEquity      Decimal? @map("total_equity") @db.Decimal(20, 2)
  totalLiabilities Decimal? @map("total_liabilities") @db.Decimal(20, 2)
  cashEquivalents  Decimal? @map("cash_equivalents") @db.Decimal(20, 2)
  revenueGrowth    Decimal? @map("revenue_growth") @db.Decimal(8, 4)
  netIncomeGrowth  Decimal? @map("net_income_growth") @db.Decimal(8, 4)
  financialPeriod  String?  @default("TTM / FY2024") @map("financial_period") @db.VarChar(50)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  stock Stock @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([peRatio])
  @@index([pbvRatio])
  @@index([roe])
  @@index([der])
  @@map("stock_fundamentals")
}

model StockDailyPrice {
  id            String   @id @default(uuid()) @db.Uuid
  symbol        String   @unique @db.VarChar(10)
  closePrice    Decimal  @map("close_price") @db.Decimal(15, 2)
  changeAmount  Decimal  @map("change_amount") @db.Decimal(15, 2)
  changePercent Decimal  @map("change_percent") @db.Decimal(8, 4)
  openPrice     Decimal? @map("open_price") @db.Decimal(15, 2)
  highPrice     Decimal? @map("high_price") @db.Decimal(15, 2)
  lowPrice      Decimal? @map("low_price") @db.Decimal(15, 2)
  volume        BigInt?
  lastUpdated   DateTime @default(now()) @updatedAt @map("last_updated") @db.Timestamptz(6)

  stock Stock @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@map("stock_daily_prices")
}

model NewsSentiment {
  id             String         @id @default(uuid()) @db.Uuid
  symbol         String?        @db.VarChar(10)
  title          String         @db.VarChar(300)
  description    String?        @db.Text
  imageUrl       String?        @map("image_url") @db.Text
  source         String         @db.VarChar(100)
  url            String         @db.Text
  sentiment      SentimentLabel @default(NEUTRAL)
  sentimentScore Decimal?       @map("sentiment_score") @db.Decimal(4, 2)
  publishedAt    DateTime       @map("published_at") @db.Timestamptz(6)
  cachedAt       DateTime       @default(now()) @map("cached_at") @db.Timestamptz(6)

  stock Stock? @relation(fields: [symbol], references: [symbol], onDelete: SetNull)

  @@index([symbol])
  @@index([publishedAt])
  @@map("news_sentiment")
}

model MacroMarket {
  id            String        @id @default(uuid()) @db.Uuid
  assetCategory MacroCategory @map("asset_category")
  assetName     String        @map("asset_name") @db.VarChar(100)
  symbolCode    String        @unique @map("symbol_code") @db.VarChar(20)
  price         Decimal       @db.Decimal(15, 2)
  changePercent Decimal       @map("change_percent") @db.Decimal(8, 4)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("macro_markets")
}

model Watchlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  symbol    String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([userId, symbol])
  @@map("watchlists")
}

model AiAnalysisLog {
  id                     String          @id @default(uuid()) @db.Uuid
  userId                 String?         @map("user_id") @db.Uuid
  symbol                 String?         @db.VarChar(10)
  investorProfile        InvestorProfile @map("investor_profile")
  userQuestion           String          @map("user_question") @db.Text
  groundedContext        Json            @map("grounded_context")
  aiResponse             String          @map("ai_response") @db.Text
  factualConsistencyScore Decimal?       @map("factual_consistency_score") @db.Decimal(5, 2)
  hallucinationFlag      Boolean         @default(false) @map("hallucination_flag")
  latencyMs              Int             @map("latency_ms")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  stock Stock? @relation(fields: [symbol], references: [symbol], onDelete: SetNull)

  @@index([symbol])
  @@index([createdAt])
  @@map("ai_analysis_logs")
}

model ApiCache {
  id           String   @id @default(uuid()) @db.Uuid
  provider     String   @db.VarChar(50)
  endpointKey  String   @unique @map("endpoint_key") @db.VarChar(150)
  responseData Json     @map("response_data")
  fetchedAt    DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([provider, endpointKey])
  @@index([expiresAt])
  @@map("api_cache")
}

// ==========================================
// SUB-SISTEM 2: FIRMAN (PORTOFOLIO & EDUKASI)
// ==========================================

model PortfolioTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  symbol          String          @db.VarChar(10)
  transactionType TransactionType @map("transaction_type")
  price           Decimal         @db.Decimal(15, 2)
  lotQuantity     Int             @map("lot_quantity")
  transactionDate DateTime        @map("transaction_date") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [symbol], references: [symbol], onDelete: Restrict)

  @@index([userId])
  @@index([symbol])
  @@map("portfolio_transactions")
}

// Modul materi pembelajaran kurikulum 3 level (KF-02, KF-16, PB-12)
model LearningModule {
  id               String          @id @default(uuid()) @db.Uuid
  title            String          @db.VarChar(200)
  slug             String          @unique @db.VarChar(200)
  level            DifficultyLevel
  summary          String?         @db.VarChar(500)
  contentBody      String          @map("content_body") @db.Text
  estimatedMinutes Int             @default(5) @map("estimated_minutes")
  orderIndex       Int             @default(1) @map("order_index")
  isPublished      Boolean         @default(true) @map("is_published")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  quizQuestions      QuizQuestion[]
  learningProgresses LearningProgress[]
  quizAttempts       QuizAttempt[]

  @@index([level, orderIndex])
  @@index([isPublished])
  @@map("learning_modules")
}

// Progres belajar pengguna per modul, terpisah dari nilai kuis (KF-03)
model LearningProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  moduleId    String    @map("module_id") @db.Uuid
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  module LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId], map: "uq_user_learning_module")
  @@map("learning_progress")
}

// Bank soal kuis evaluasi pilihan ganda A-D (KF-04, KF-16, PB-13)
model QuizQuestion {
  id               String        @id @default(uuid()) @db.Uuid
  moduleId         String        @map("module_id") @db.Uuid
  questionText     String        @map("question_text") @db.Text
  optionA          String        @map("option_a") @db.VarChar(255)
  optionB          String        @map("option_b") @db.VarChar(255)
  optionC          String        @map("option_c") @db.VarChar(255)
  optionD          String        @map("option_d") @db.VarChar(255)
  correctKey       QuizOptionKey @map("correct_key")
  explanationText  String        @map("explanation_text") @db.Text
  indicatorConcept String        @map("indicator_concept") @db.VarChar(150)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  module LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("quiz_questions")
}

// Riwayat percobaan kuis + payload umpan balik LLM (KF-05, KF-17)
model QuizAttempt {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  moduleId          String   @map("module_id") @db.Uuid
  scorePercentage   Decimal  @map("score_percentage") @db.Decimal(5, 2)
  answersPayload    Json     @map("answers_payload")
  aiFeedbackPayload Json?    @map("ai_feedback_payload")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  module LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([userId, moduleId])
  @@map("quiz_attempts")
}
